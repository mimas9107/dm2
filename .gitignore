# ==============================================================================
# 來電送 CALL & DELIVER — .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 作業系統產生檔 (Operating System Files)
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 編輯器與 IDE 設定 (Editor & IDE Directories)
# ------------------------------------------------------------------------------
# VS Code (若團隊需要共享 extensions.json / launch.json 可視需要解除註解)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (WebStorm, IntelliJ IDEA, etc.)
.idea/
*.iws
*.iml
*.ipr

# Sublime Text / Atom
*.sublime-project
*.sublime-workspace
.atom/

# Vim / Emacs 暫存檔
*.swp
*.swo
*~
.#*
#*#

# ------------------------------------------------------------------------------
# Node.js / 套件管理與除錯紀錄 (Node.js & Logs)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ------------------------------------------------------------------------------
# 雲端佈署與 CLI 暫存 (Cloudflare / Serverless Deployment)
# ------------------------------------------------------------------------------
.wrangler/
.cloudflare/

# ------------------------------------------------------------------------------
# 環境變數與機密資訊 (Environment & Secrets)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
!.env.example

# ------------------------------------------------------------------------------
# 測試輸出與暫存檔 (Test Artifacts & Temp Files)
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
*.log
*.tmp
*.temp
.cache/
